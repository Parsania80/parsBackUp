[Unit]
Description=Signed fixture PostgreSQL backup for profile %i
Documentation=file:/usr/share/doc/backupctl/h03-systemd-package.md
After=network.target

[Service]
Type=oneshot
User=backupctl
Group=backupctl
UMask=0077
StateDirectory=backupctl
StateDirectoryMode=0700
WorkingDirectory=/var/lib/backupctl
ExecStart=/usr/bin/backupctl --config /etc/backupctl/profiles/%i.toml --output json-v1 backup create --profile %i --confirm-synthetic
StandardInput=null
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2h
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=1024
TasksMax=128
MemoryMax=2G
