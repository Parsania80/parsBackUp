#!/bin/sh
set -eu
case "$1" in
    configure)
        if ! getent passwd backupctl >/dev/null; then
            adduser --system --group --home /var/lib/backupctl --no-create-home --shell /usr/sbin/nologin backupctl
        fi
        entry=$(getent passwd backupctl)
        uid=$(id -u backupctl)
        gid=$(id -g backupctl)
        if [ "$uid" = 0 ] || [ "$(id -gn backupctl)" != backupctl ] ||
           [ "$(printf '%s' "$entry" | cut -d: -f6-7)" != /var/lib/backupctl:/usr/sbin/nologin ]; then
            echo 'backupctl: incompatible existing service identity; refusing custody changes' >&2
            exit 1
        fi
        private_directory() {
            path=$1 owner=$2 group=$3 mode=$4
            if [ -e "$path" ] || [ -L "$path" ]; then
                if [ -L "$path" ] || [ ! -d "$path" ] ||
                   [ "$(stat -c '%u:%g:%a' "$path")" != "$owner:$group:$mode" ]; then
                    echo "backupctl: unsafe existing directory: $path" >&2
                    exit 1
                fi
            else
                install -d -o "$owner" -g "$group" -m "$mode" "$path"
            fi
        }
        private_directory /etc/backupctl 0 "$gid" 750
        private_directory /etc/backupctl/profiles 0 "$gid" 750
        private_directory /etc/backupctl/keys "$uid" "$gid" 700
        private_directory /etc/backupctl/credentials "$uid" "$gid" 700
        private_directory /var/lib/backupctl "$uid" "$gid" 700
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
esac
